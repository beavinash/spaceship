+    for (int decision = 0; decision < 125000; ++decision) {
+        SpaceAction actions[SPACE_MAX_AGENTS] = {{0}};
+        for (int agent = 0; agent < 8; ++agent) {
+            rng = rng * UINT32_C(1664525) + UINT32_C(1013904223);
